@using FactureEntities.Entities;
@*Model*@
@model List<Facture>
<a asp-controller="Facture" asp-action="Create" class="btn btn-primary">Ajouter une nouvelle Facture</a>
<h1>Liste des factures</h1>
<img src="~/image/git.png" />
@* <img src="https://i.etsystatic.com/27196758/r/il/f1eb62/6583710481/il_340x270.6583710481_326l.jpg"/> *@
<table id ="tableFacture" class="table table-striped table-sm">
    <thead>
        <tr>
            <th scope="col">N°</th>
            <th scope="col">Date</th>
            <th scope="col">Client</th>
            <th scope="col">Total</th>
            <th scope="col">&nbsp;</th>
        </tr>
    </thead>
    <tbody>
        @foreach(Facture f in Model)
        {
            <tr>
                <td scope="col">@f.Id</td>
                <td>@f.DateFacture</td>
                <td align="right">@f.Client.Nom</td>
                <td align="right">@f.TotalFacture</td>
                <td align="right"><a class="btn btn-dark btn-sm" asp-controller="Facture" asp-action="Modifier" asp-route-id="@f.Id">modifier</a></td>
            </tr>
        }
    </tbody>
</table>
